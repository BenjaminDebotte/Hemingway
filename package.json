{
  "name": "peche-fiches-techniques-normandie",
  "version": "1.0.0",
  "description": "Générateur et viewer de fiches techniques halieutiques pour le littoral normand (Canal de Caen à la mer & Côte de Nacre en bateau)",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-species.mjs",
    "build": "node scripts/build-site.mjs",
    "test": "node scripts/test-browser-devtools.mjs",
    "start": "node --watch --watch-path=data --watch-path=scripts --watch-path=site/index.html --watch-path=site/css --watch-path=site/js scripts/serve.mjs",
    "dev": "node --watch --watch-path=data --watch-path=scripts --watch-path=site/index.html --watch-path=site/css --watch-path=site/js scripts/serve.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "keywords": [
    "peche",
    "normandie",
    "calvados",
    "caen",
    "ouistreham",
    "cote-de-nacre",
    "fiches-techniques"
  ],
  "author": "Pêche Normandie",
  "license": "MIT"
}
